# Build outputs (per plugin project)
build/
dist/

# Locally installed toolchain helpers (zig venv, host_sim binary, docker marker)
.sdk-tools/

# Users' own plugin projects live here; the SDK repo only tracks the placeholder
plugins/*
!plugins/.gitkeep
