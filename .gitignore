!plugins/Ommi Amp
!plugins/Ommi EQ
!plugins/Ommi Pedalboard

# Python
__pycache__/
*.pyc

# OS cruft
.DS_Store
Thumbs.db

# Saved MPC device settings (address, drive) for tools/mpc_remote.py
.mpc-device.json
